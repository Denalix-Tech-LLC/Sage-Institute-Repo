# =============================================================================
# The Sage Institute — environment variables
# Copy this file to .env.local for local development, and add the same keys to
# your host's Production environment (then redeploy) for the live site.
# NEVER commit real secret values. .env*.local is git-ignored.
# =============================================================================

# --- Editor passwords --------------------------------------------------------
# /admin — site-wide content (Home, About, Services, Contact, SEO, navigation,
# footer, 404). Anyone with this password can edit those. Choose something long.
ADMIN_PASSWORD=change-me-to-a-long-password

# /admin-blogs — Blog posts and Events & Classes only. Give this one to whoever
# writes posts; it cannot change the rest of the site.
ADMIN_BLOG_PASSWORD=change-me-to-a-different-long-password

# --- GitHub save fallback (required only on read-only hosts like Vercel) ------
# On a serverless host the filesystem is read-only, so saves are committed to
# the GitHub repo instead (the host then auto-redeploys). Not needed for local
# development. See the README for how to create the token.
#
# GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx   # fine-grained PAT, Contents: Read and write
# GITHUB_REPO=owner/repo                            # e.g. Denalix-Tech-LLC/Sage-Institute-Repo
# GITHUB_BRANCH=main                                # optional; defaults to "main"

# --- Optional --------------------------------------------------------------
# Absolute base URL for canonical + Open Graph tags. Defaults to the URL in
# content/site-content.json; set this only to preview OG cards on a tunnel.
# NEXT_PUBLIC_SITE_URL=https://your-preview-host.example.com
